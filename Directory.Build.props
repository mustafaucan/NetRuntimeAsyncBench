<Project>
  <!-- Bu dosya, alt klasörlerdeki TÜM projelere otomatik uygulanır.
       Ortak ayarları üç kez yazmamak için burada topladık. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RuntimeAsyncBench</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ortak kaynak kod: ../Shared içindeki tüm .cs dosyaları her projeye dahil edilir. -->
    <Compile Include="$(MSBuildThisFileDirectory)Shared\**\*.cs" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
